[Unit]
Description=pk service -- stateless Bateman-curve calculator (ADHD medication manager)
After=network.target

[Service]
Type=simple
WorkingDirectory=/vagrant/pk
Environment=DJANGO_SETTINGS_MODULE=pk.settings
Environment=PK_ALLOWED_HOSTS=192.168.56.11,pk,localhost,127.0.0.1
ExecStart=/opt/pk/venv/bin/gunicorn pk.wsgi --bind 0.0.0.0:8001
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
