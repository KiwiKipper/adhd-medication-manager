# Shared proxy headers for every location that reaches gunicorn on the
# backend VM.
#
# $http_host (not $host) is deliberate, and the reverse of what this file
# used to say: Django's HttpRequest.get_host() already strips the port
# before checking ALLOWED_HOSTS, so keeping the port here costs nothing
# there. What it buys is CSRF: Django's same-origin check compares the
# browser's Origin header against "scheme://" + get_host(), port included.
# With $http_host, that comparison is against whatever host:port the
# browser actually loaded the page from -- so it still passes even if the
# Vagrantfile's host port forward got auto-corrected away from 8000, with
# no CSRF_TRUSTED_ORIGINS entry needed for the port that happened to land on.
proxy_set_header Host $http_host;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_redirect off;
