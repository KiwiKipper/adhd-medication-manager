# Environment for both the gunicorn unit (via EnvironmentFile) and the
# `manage.py migrate`/`collectstatic`/`seed_demo` calls in
# scripts/backend.sh, so none of them can drift apart and disagree about
# which database they are touching.
#
# systemd parses this file itself, not a shell: KEY=value only, no `export`,
# no quoting, no variable expansion. A value is literal text to end of line,
# which is why the secret key below can carry `(`, `!`, `#` and `$` unquoted.
# scripts/backend.sh reads this file with a key/value loop rather than
# sourcing it, so that systemd's reading stays the only one.

# A real deployment would generate this per host and keep it out of version
# control. It is checked in here because this is a marked coursework VM with
# no public exposure -- see the README's security notes.
DJANGO_SECRET_KEY=django-insecure-vm-only-6t2w!kq0v#8zr(3ymx1a$5ldp7ng4jhc)e_bu9s
DJANGO_DEBUG=False

# Host header values Django will answer to: the backend VM's own private IP
# and hostname, plus the frontend VM's, since that is whose nginx actually
# proxies requests here (as $http_host -- see
# frontend/deploy/proxy_params_backend -- so the Host header on a proxied
# request carries whatever the browser sent, not "frontend").
# localhost/127.0.0.1 cover the debug port forward and running this VM's
# checks over loopback.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.56.11,backend,192.168.56.12,frontend

# Matches the role/database scripts/db.sh creates on the db VM.
DB_ENGINE=postgresql
DB_NAME=adhd
DB_USER=adhd
DB_PASSWORD=password
DB_HOST=192.168.56.10
DB_PORT=5432

# Seeds the demo accounts (admin, dev1) with ten days of dose/note history
# on every provision, skipping any that already exist -- see
# tracker/management/commands/seed_demo.py. scripts/backend.sh adds --reset
# only when SEED_RESET=1 is set before `vagrant provision`.
SEED_DEMO=1

# The frontend VM's nginx serves the SPA and proxies the API from one
# origin, so the browser never makes a cross-origin request in this
# deployment and CORS is not actually exercised there. CSRF still checks the
# Origin header on every POST, which is why the entry point is trusted here
# by both the host's forwarded port and the frontend VM's own address -- a
# host-port auto-correct (see the Vagrantfile) still passes, because the
# relative API base URL means the browser's Origin always matches whatever
# port it actually loaded the page from. The debug port (8001, forwarded
# straight to this VM) and the Vite dev-server origin are both here so a
# laptop frontend, or a direct curl at the backend, can reach this API too.
DJANGO_CSRF_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://192.168.56.12,http://localhost:8001
DJANGO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
