# Managed PostgreSQL. Replaces the Vagrant `db` VM (scripts/db.sh): AWS runs
# the engine, patching, backups and storage; we only supply configuration.

# Generated by Terraform so nobody types or commits it. Letters and digits
# only, so it is safe inside a URL and a systemd EnvironmentFile.
resource "random_password" "db" {
  length  = 24
  special = false
}

# RDS needs subnets in at least two availability zones; the default VPC has
# one per AZ.
resource "aws_db_subnet_group" "db" {
  name       = "${var.project}-db"
  subnet_ids = data.aws_subnets.default.ids

  tags = { Name = "${var.project}-db" }
}

resource "aws_db_instance" "db" {
  identifier     = "${var.project}-db"
  engine         = "postgres"
  engine_version = "16"
  instance_class = "db.t3.micro"

  allocated_storage = 20
  storage_type      = "gp2"

  # Same database and role names the Vagrant db VM used, so the Django
  # settings need no changes.
  db_name  = "adhd"
  username = "adhd"
  password = random_password.db.result

  db_subnet_group_name   = aws_db_subnet_group.db.name
  vpc_security_group_ids = [aws_security_group.db.id]
  publicly_accessible    = false
  multi_az               = false

  backup_retention_period = 1
  apply_immediately       = true

  # Coursework stack: `terraform destroy` must not leave a snapshot behind
  # (and must not fail asking for a snapshot name). The cost is that destroy
  # deletes the data. The README says so.
  skip_final_snapshot = true

  tags = { Name = "${var.project}-db" }
}

output "rds_endpoint" {
  description = "Hostname of the RDS instance (no port)."
  value       = aws_db_instance.db.address
}
