#!/bin/bash
# Rendered by Terraform (templatefile) and run once by cloud-init as root.
# Output goes to /var/log/cloud-init-output.log.
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive

# Swap first. t3.micro has 1 GB of RAM and `vite build` gets OOM-killed
# without it ("Killed" partway through the build).
fallocate -l 2G /swapfile
chmod 600 /swapfile
mkswap /swapfile
swapon /swapfile

apt-get update
apt-get install -y git

git clone --depth 1 -b ${git_ref} https://github.com/KiwiKipper/adhd-medication-manager.git /opt/dose

# Both instances boot at the same time, but the backend only finishes after
# RDS exists and migrations have run. frontend.sh waits just 60 seconds for
# the backend, so wait here (up to 25 minutes) before handing over.
for attempt in $(seq 1 150); do
    if curl -sf http://${backend_private_ip}:8000/auth/csrf/ > /dev/null; then
        break
    fi
    sleep 10
done

export APP_ROOT=/opt/dose BACKEND_ADDR=${backend_private_ip}
bash /opt/dose/scripts/common.sh
bash /opt/dose/scripts/frontend.sh
