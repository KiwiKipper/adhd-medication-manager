# Environment for both the gunicorn unit (via EnvironmentFile) and the
# `manage.py migrate`/`collectstatic` calls in provisions/web.sh, so the two
# can never drift apart and disagree about which database they are touching.
#
# systemd parses this file itself, not a shell: KEY=value only, no `export`,
# no quoting, no variable expansion.

# A real deployment would generate this per host and keep it out of version
# control. It is checked in here because this is a marked coursework VM with
# no public exposure -- see the README's security notes.
DJANGO_SECRET_KEY=django-insecure-vm-only-6t2w!kq0v#8zr(3ymx1a$5ldp7ng4jhc)e_bu9s
DJANGO_DEBUG=False

# Host header values Django will answer to. `localhost` is here because the
# Vagrantfile forwards guest 8000 to host 8000, so a browser on the host
# reaches nginx with `Host: localhost`.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.56.12,web

# Matches the role/database provisions/db.sh creates on the db VM.
DB_ENGINE=postgresql
DB_NAME=adhd
DB_USER=adhd
DB_PASSWORD=password
DB_HOST=192.168.56.10
DB_PORT=5432

PK_SERVICE_URL=http://192.168.56.11:8001
PK_SERVICE_TIMEOUT=5

# nginx serves the SPA and proxies the API from one origin, so the browser
# never makes a cross-origin request in this deployment and CORS is not
# actually exercised. CSRF still checks the Origin header on every POST,
# which is why both spellings of the entry point are trusted here. The Vite
# dev-server origin stays allowed so a laptop frontend can point at the VM.
DJANGO_CSRF_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://192.168.56.12:8000
DJANGO_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://192.168.56.12:8000,http://localhost:5173
